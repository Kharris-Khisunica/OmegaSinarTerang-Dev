# ============================================================
# .env PRODUKSI — salin jadi `.env` di folder yang sama dengan
# docker-compose.prod.yml. JANGAN commit file .env.
# Isi semua nilai bertanda GANTI. Generate secret: lihat README.
# ============================================================

# Versi image yang dijalankan (harus ada di `docker images`).
APP_VERSION=1.0.0

# Port web yang dipublish ke LAN (satu-satunya port terbuka).
HTTP_PORT=80

# URL akses pengguna di LAN (dipakai CORS backend).
# Contoh: http://192.168.1.50  (IP statis PC klien)
FRONTEND_ORIGIN=http://GANTI-IP-PC

# ---- Database ---------------------------------------------
DB_USERNAME=omega
DB_PASSWORD=GANTI-password-db-acak-panjang
DB_NAME=omega

# ---- JWT --------------------------------------------------
# Dua secret BERBEDA, masing-masing >= 48 karakter acak.
# Mengganti secret = semua pengguna otomatis logout (tidak merusak data).
JWT_ACCESS_SECRET=GANTI
JWT_REFRESH_SECRET=GANTI

# ---- Identitas ---------------------------------------------
COMPANY_NAME=Omega Sinar Terang

# ---- Seed awal (dipakai sekali saat install: `seed:prod`) ---
# Password minimal 10 karakter dan tidak boleh sama dengan username.
# Setelah login pertama, ganti/tambah pengguna lewat aplikasi lalu
# hapus SEED_MASTER_PASSWORD dari file ini.
SEED_MASTER_USERNAME=master
SEED_MASTER_PASSWORD=GANTI-minimal-10-karakter
SEED_MASTER_FULLNAME=Master
STORE_NAME=
STORE_CITY=
STORE_PHONE=

# ---- CATATAN KUNCI pgcrypto --------------------------------
# Aplikasi ini TIDAK memakai kunci enkripsi pgcrypto. Extension pgcrypto
# hanya dipakai untuk gen_random_uuid() — tidak ada kunci yang harus
# dibackup. Yang WAJIB dibackup terpisah (di luar PC klien): file .env ini
# (password DB + JWT secret) dan dump database dari backup.ps1.
# Kehilangan .env = harus mengatur ulang password DB; kehilangan dump = data hilang.
